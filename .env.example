# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase
# (Project Settings → API). La "anon key" es pública por diseño; los datos los protegen las reglas RLS.
# .env.local nunca se sube a GitHub. En Vercel, estas variables van en Settings → Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Pon "si" cuando Google esté activado en Supabase (Authentication → Sign In / Providers).
VITE_GOOGLE_ACTIVO=
